# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ----------------------------------------------------------------------
# AMAZON CREATORS API (Official Replacement for Deprecated PA-API 5)
# ----------------------------------------------------------------------
# OAuth 2.0 Credential ID from Amazon Creators Console
AMAZON_CREATORS_CREDENTIAL_ID=
# OAuth 2.0 Credential Secret
AMAZON_CREATORS_CREDENTIAL_SECRET=
# Credential Version (e.g. "2.1")
AMAZON_CREATORS_CREDENTIAL_VERSION="2.1"
# Amazon Associates / Influencer Partner Tag (e.g. "reseller-20")
AMAZON_PARTNER_TAG=
# Amazon Marketplace Country Code (e.g. "US", "CA", "UK")
AMAZON_MARKETPLACE="US"

# ----------------------------------------------------------------------
# EBAY OFFICIAL APIS (Catalog API, Browse API & Marketplace Insights)
# ----------------------------------------------------------------------
# eBay Developer Program App ID (Client ID)
EBAY_CLIENT_ID=
# eBay Developer Program Cert ID (Client Secret)
EBAY_CLIENT_SECRET=
# eBay Environment ("PRODUCTION" or "SANDBOX")
EBAY_ENVIRONMENT="PRODUCTION"
# eBay Marketplace ID (default "EBAY_US")
EBAY_MARKETPLACE_ID="EBAY_US"
# eBay Marketplace Insights Commercial Partner Approval ("true" or "false")
EBAY_MARKETPLACE_INSIGHTS_APPROVED="false"

# ----------------------------------------------------------------------
# FIRECRAWL SUPPLEMENTARY PRODUCT RESEARCH (Optional Public Page Extractor)
# ----------------------------------------------------------------------
# Firecrawl API Key (server-side only; set in local .env, never commit key values)
FIRECRAWL_API_KEY=
# Enable or disable Firecrawl supplementary extraction ("true" or "false")
FIRECRAWL_ENABLED="true"
# Optional Firecrawl v2 API Base URL override (must be HTTPS on port 443 and match an allowed host)
FIRECRAWL_API_BASE_URL="https://api.firecrawl.dev/v2"
# Optional comma-separated allowlist of additional trusted Firecrawl API hostnames (default only allows api.firecrawl.dev)
FIRECRAWL_ALLOWED_API_HOSTS=""
# Optional request timeout in milliseconds (default 15000)
FIRECRAWL_TIMEOUT_MS="15000"
# Optional cache TTL in milliseconds (default 21600000 = 6 hours)
FIRECRAWL_CACHE_TTL_MS="21600000"
# Optional staleness warning threshold in milliseconds (default 3600000 = 1 hour)
FIRECRAWL_STALE_THRESHOLD_MS="3600000"
# Optional access token to require x-research-access-token / Bearer authentication on /api/research/* routes
RESEARCH_API_ACCESS_TOKEN=""

